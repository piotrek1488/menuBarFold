"about.tagline" = "Uporządkowany pasek menu w macOS 27";
"about.version" = "Wersja 0.1.0";
"about.privacy.title" = "Wszystko zostaje na Macu";
"about.privacy.detail" = "MenuBarFold nie ma kodu sieciowego, analityki, konta, dostępu do plików ani procesów pomocniczych. Dane Accessibility są używane wyłącznie w pamięci do ustalenia położenia ikon.";
"about.macos27.title" = "Dlaczego tej wersji nie będzie w App Store";
"about.macos27.detail" = "macOS 27 udostępnia filtrowanie ikon jedynie przez prywatny framework systemowy powiązany z trybem assessment. MenuBarFold ładuje go dynamicznie i pokazuje cały pasek, jeśli Apple go zmieni. Wymaga to bezpośrednio dystrybuowanej aplikacji bez sandboxa.";
"about.acknowledgements.title" = "Podziękowania";
"about.acknowledgements.detail" = "Mechanizmy widoczności i natywnego menu przepełnienia w macOS 27 zostały opracowane na podstawie projektów Hidden Bar, MenuBarHider i MenubarHide na licencji MIT. MenuBarFold jest niezależną implementacją w SwiftUI i AppKit.";

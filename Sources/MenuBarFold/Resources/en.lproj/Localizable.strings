"about.tagline" = "A focused menu bar for macOS 27";
"about.version" = "Version %@";
"about.privacy.title" = "Local by design";
"about.privacy.detail" = "MenuBarFold has no network code, analytics, account, file access, or subprocesses. Accessibility data is used in memory only to classify menu bar item positions.";
"about.macos27.title" = "Why this build is outside the App Store";
"about.macos27.detail" = "macOS 27 exposes icon filtering only through a private system framework tied to assessment mode. MenuBarFold loads it at runtime and fails open if Apple changes it. This requires a direct, non-sandboxed build.";
"about.acknowledgements.title" = "Acknowledgements";
"about.acknowledgements.detail" = "The macOS 27 visibility research was informed by the MIT-licensed Hidden Bar, MenuBarHider, and MenubarHide projects. MenuBarFold is an independent SwiftUI and AppKit implementation.";
